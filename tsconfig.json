{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@config/*": ["config/*"],
      "@types/*": ["types/*"],
      "@logger/*": ["logger/*"],
      "@market-data/*": ["market-data/*"],
      "@external-feed/*": ["external-feed/*"],
      "@opportunity/*": ["opportunity/*"],
      "@strategy/*": ["strategy/*"],
      "@execution/*": ["execution/*"],
      "@paper-trading/*": ["paper-trading/*"],
      "@risk-manager/*": ["risk-manager/*"],
      "@portfolio/*": ["portfolio/*"],
      "@metrics/*": ["metrics/*"],
      "@dashboard/*": ["dashboard/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
