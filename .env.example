# ============================================================
# Polymarket Trading Bot v2 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit your .env file.
# ============================================================

# --- Trading Mode ---
# PAPER = simulated trades (default, safe)
# LIVE  = real trades (requires API keys, USE WITH EXTREME CAUTION)
TRADING_MODE=PAPER

# --- Polymarket API ---
# Get your API key from https://polymarket.com (profile > API)
# Only required for LIVE mode.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Polymarket CLOB API ---
# Mainnet: https://clob.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# --- Target Market ---
# The Polymarket market to monitor. Condition ID from the market URL.
POLYMARKET_MARKET_ID=
# The external symbol to track (e.g., BTCUSDT for Bitcoin 5-min markets)
EXTERNAL_SYMBOL=BTCUSDT

# --- External Price Feed ---
# Binance WebSocket for real-time crypto price reference.
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# --- Fee Configuration ---
# Market type: '5m' (0.44% max fee), '15m' (1.56% max fee), '1h' (1.56%)
MARKET_TYPE=5m
# Use maker orders? true = 0 fee + rebates, false = pays taker fee
PREFER_MAKER=true

# --- Entry Timing (Last-Second Strategy) ---
# Start looking for entries N seconds before window end (default: 15)
ENTRY_WINDOW_START_S=12
# Stop entering N seconds before window end (safety buffer, default: 3)
ENTRY_WINDOW_END_S=3

# --- Risk Limits ---
# Maximum stake per single trade in USDC
MAX_STAKE_PER_TRADE=2
# Maximum number of trades per hour
MAX_TRADES_PER_HOUR=9999
# Maximum daily drawdown in USDC before halting
MAX_DAILY_DRAWDOWN=50
# Maximum consecutive losses before halting
MAX_CONSECUTIVE_LOSSES=9999

# --- Paper Trading ---
# Starting balance for paper trading in USDC
PAPER_STARTING_BALANCE=50

# --- Timing ---
# Window duration in seconds (e.g., 300 = 5 minutes)
WINDOW_DURATION_SECONDS=300

# --- Logging ---
# Log level: debug, info, warn, error
LOG_LEVEL=info
# Log to file? true/false
LOG_TO_FILE=true
# Log directory
LOG_DIR=./logs

# --- Dashboard ---
# Enable terminal dashboard
DASHBOARD_ENABLED=true
# Dashboard refresh interval in milliseconds
DASHBOARD_REFRESH_MS=1000
